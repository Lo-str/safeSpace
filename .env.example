# Root-level env used by docker-compose. Copy to `.env` and fill in real values.
# Per-service .env files (server/.env, client/.env) are still used for local non-Docker dev.

# --- Database (local Postgres container) ---
POSTGRES_USER=safespace
POSTGRES_PASSWORD=changeme
POSTGRES_DB=safespace

# --- Server (Auth0) ---
AUTH0_AUDIENCE=https://your-team-project/
AUTH0_ISSUER_BASE_URL=https://dev-team.region.auth0.com/
# CLIENT_ORIGIN accepts a comma-separated list of allowed CORS origins.
# Example (prod): CLIENT_ORIGIN=http://localhost:5173,https://safe-space.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# --- Client (baked into Vite build) ---
VITE_API_BASE_URL=http://localhost:4000
VITE_AUTH0_DOMAIN=dev-team.region.auth0.com
VITE_AUTH0_CLIENT_ID=AbCdEfGhIjKlMnOpQrStUvWxYz
VITE_AUTH0_AUDIENCE=https://your-team-project/
