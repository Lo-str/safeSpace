generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  name                String?
  password            String
  reviews             Review[]
  spaces              Space[]
  ratings             Rating[]
  reports             Report[]
  favorites           Favorite[]
  accessibilityInfos  AccessibilityInfo[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  content   String
  rating    Int
  userId    String?
  spaceId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])
  space Space @relation(fields: [spaceId], references: [id])
}

model Space {
  id                  String   @id @default(uuid())
  name                String
  description         String?
  location            String
  price               Float
  userId              String
  favorites           Favorite[]
  ratings             Rating[]
  reviews             Review[]
  media               Media[]
  reports             Report[]
  accessibilityInfos  AccessibilityInfo[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User @relation(fields: [userId], references: [id])
}

model Rating {
  id        String   @id @default(uuid())
  value     Int
  userId    String
  spaceId   String
  createdAt         DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  space Space @relation(fields: [spaceId], references: [id])
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Location {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id        String   @id @default(uuid())
  url       String
  spaceId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  space Space @relation(fields: [spaceId], references: [id])
}

model Report {
  id        String   @id @default(uuid())
  reason    String
  userId    String
  spaceId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  space Space @relation(fields: [spaceId], references: [id])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  spaceId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  space Space @relation(fields: [spaceId], references: [id])
}

model AccessibilityInfo {
  id        String   @id @default(uuid())
  name      String   @unique
  userId    String?
  spaceId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])
  space Space? @relation(fields: [spaceId], references: [id])
}
